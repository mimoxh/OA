DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"
ATTACHMENT_DIR="storage/attachments"

REALTIME_PORT=1235
NEXT_PUBLIC_REALTIME_URL="ws://localhost:1235"
REALTIME_INTERNAL_URL="http://localhost:1235"
# REDIS_URL="redis://localhost:6379"

# 文件存储（默认 local 写入 ./data/uploads；多实例部署可切换 s3 兼容对象存储）
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="./data/uploads"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="oa-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

# WebRTC 使用 ICE_SERVERS 配置 STUN/TURN。LiveKit 配置供可选令牌接口使用。
# ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]}]'
# LIVEKIT_URL="wss://livekit.example.com"
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# Webhook 机器人：OA_PUBLIC_BASE_URL 用于生成推送给外部 Bot 的回复地址（reply.endpoint）。
# 生产环境默认禁止向内网/本机地址推送；如外部 Bot 部署在内网，设置 WEBHOOK_ALLOW_PRIVATE_NETWORK="true"。
# OA_PUBLIC_BASE_URL="http://127.0.0.1:3000"
# WEBHOOK_ALLOW_PRIVATE_NETWORK="false"

# 飞牛 NAS（fnOS）单容器部署环境变量模板
# 使用前复制为 .env.nas（不要提交包含真实密钥的 .env.nas 到代码仓库）

# ==================== 1. 镜像、端口与宿主机持久化目录 ====================

# 镜像名称（电脑构建导入后默认 oa-suite:latest，也可改为私有仓库地址）
OA_IMAGE=oa-suite:latest

# 宿主机对外映射端口（单个端口同时承载 Web、/collab、/rt、/health）
OA_HOST_PORT=3000

# 3 个持久化目录（按飞牛实际存储卷路径修改，请勿使用 SMB/NFS 网络共享路径）
# - 数据库目录：强烈建议放在 SSD 卷（如 /vol1），以保障 SQLite WAL 并发性能
OA_DB_DIR=/vol1/1000/docker/oa/db
# - 文档附件目录：可放 SSD 或大容量 HDD 卷
OA_ATTACHMENTS_DIR=/vol1/1000/docker/oa/attachments
# - IM 上传目录：增长最快，推荐放 HDD 大容量卷（如 /vol2）；若无双卷也可放在 /vol1
OA_UPLOADS_DIR=/vol1/1000/docker/oa/uploads

# 可选：指定容器运行 UID/GID（如飞牛首个管理员通常为 1000:1000）。
# 留空时默认以 root 启动，直接兼容任意宿主机目录属主，避免 SQLite 写入 -wal/-shm 报权限错误。
# PUID=1000
# PGID=1000

# ==================== 2. 核心安全密钥（必须固定持久化） ====================

# JWT 会话签名与 Webhook 机器人凭据（AES-256-GCM）加密根密钥。
# - 全新部署：请用 `openssl rand -base64 48` 生成并妥善备份，切勿随意更改！
#   （更改会导致所有已登录会话失效，且已保存的 Webhook 机器人凭据无法解密）
# - 从 Windows 桌面端迁移：可把原 workspace\secret.key 内容填到这里，
#   或直接把 secret.key 放到宿主机 OA_DB_DIR 目录下并将下方留空（程序会自动读取）。
AUTH_SECRET=please-replace-with-openssl-rand-base64-48

# ==================== 3. 访问模式（局域网 HTTP vs HTTPS 反代） ====================

# 模式 A（纯局域网 HTTP，例如 http://192.168.1.20:3000）：必须设为 false，否则浏览器拒绝写入登录 Cookie
# 模式 B（经飞牛自带反代 / Lucky / NPM 套 HTTPS，例如 https://oa.example.com）：请改为 true
SESSION_COOKIE_SECURE=false

# 同源 WebSocket 路径（由单端口网关自动分流，切勿改为 localhost:1234/1235）
COLLAB_PUBLIC_URL=/collab
REALTIME_PUBLIC_URL=/rt

# ==================== 4. Webhook 机器人与局域网 Orca Bot 对接 ====================

# OA 对外可访问地址：推送给外部 Bot 的回调地址（reply.endpoint）基于此生成。
# 必须填写 Orca Bot / 外部机器人所在机器能够访问到的飞牛 NAS 地址（不要保留 127.0.0.1）：
#   - 纯局域网 HTTP 示例：http://192.168.1.20:3000
#   - HTTPS 域名反代示例：https://oa.example.com
OA_PUBLIC_BASE_URL=http://192.168.1.20:3000

# 生产环境默认禁止向内网/本机/FakeIP(198.18.0.0/15) 推送 Webhook。
# 若 Orca Bot 部署在局域网电脑或 NAS 本机，请设为 true；
# 若只需放行特定主机名，可将此项设为 false 并改用下方 WEBHOOK_ALLOWED_HOSTS。
# 注：云元数据地址（169.254.169.254、metadata.google.internal 等）始终强制拦截。
WEBHOOK_ALLOW_PRIVATE_NETWORK=true
# WEBHOOK_ALLOWED_HOSTS=orca-pc.lan,*.hooks.example.com

# 同机 Orca 基座/模型目录自动探测（可选）：
# 在飞牛 NAS Docker 容器内未安装 Orca 客户端时，以下三项保持留空即可，
# /api/im/webhooks/orca-catalog 会毫秒级优雅降级为内置预设，并支持界面手动输入任意模型 ID 与 Effort。
# ORCA_CLI_PATH=
# ORCA_USER_DATA_DIR=
# ORCA_MODEL_CATALOG_PATH=

# ==================== 5. 可选扩展（单机 NAS 默认全部无需开启） ====================

# 文件存储驱动：默认 local（落盘至 OA_UPLOADS_DIR）；如需把 IM 上传迁至 MinIO/OSS/R2 可改 s3
STORAGE_DRIVER=local
# S3_ENDPOINT=http://192.168.1.20:9000
# S3_REGION=us-east-1
# S3_BUCKET=oa-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# 多实例实时总线（单容器部署无需 Redis）
# REDIS_URL=redis://redis:6379

# 音视频通话（局域网直连可不配；跨公网或对称 NAT 可自建 coturn / LiveKit）
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

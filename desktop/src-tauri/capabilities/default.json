{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "内置启动页（选择模式、服务器设置、连接服务器）",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-launcher-state",
    "allow-server-status",
    "allow-start-server",
    "allow-restart-server",
    "allow-enter-server",
    "allow-connect-server",
    "allow-forget-server",
    "allow-allow-firewall",
    "allow-pick-data-dir",
    "allow-change-data-dir",
    "allow-default-data-target",
    "allow-desktop-context",
    "allow-window-action",
    "allow-window-is-maximized",
    "allow-open-launcher",
    "allow-open-data-dir",
    "allow-set-unread-badge",
    "allow-show-native-notification",
    "allow-focus-main-window"
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!-- debug 包额外信任用户安装的 CA，便于用自签证书的反向代理做 HTTPS 联调；release 包只信任系统 CA。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

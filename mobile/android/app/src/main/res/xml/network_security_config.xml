<?xml version="1.0" encoding="utf-8"?>
<!-- 服务器地址由用户在运行时填写（局域网 IP 不确定），因此全局允许明文 HTTP；正式外网访问应使用 HTTPS。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

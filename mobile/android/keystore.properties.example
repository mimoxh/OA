# release 签名配置示例。真实文件放在 %USERPROFILE%\.oa-mobile\keystore.properties（推荐）
# 或 mobile/android/keystore.properties（已被 .gitignore 忽略），也可用环境变量 OA_KEYSTORE_PROPERTIES 指定路径。
# storeFile 写绝对路径，或相对本文件所在目录的路径。Windows 路径用正斜杠。
storeFile=C:/Users/<用户名>/.oa-mobile/oa-release.p12
storeType=PKCS12
# 密码也可以不写在这里，改用环境变量 OA_KEYSTORE_PASSWORD / OA_KEY_PASSWORD
storePassword=<密钥库密码>
keyAlias=oa-release
keyPassword=<与 storePassword 相同（PKCS12 只有一个密码）>

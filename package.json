{
  "name": "oa-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,collab,rt -c blue,magenta,cyan \"next dev\" \"tsx watch server/collab.ts\" \"tsx watch server/realtime.ts\"",
    "dev:web": "next dev",
    "collab": "tsx server/collab.ts",
    "realtime": "tsx server/realtime.ts",
    "build": "next build",
    "start": "concurrently -k -n web,collab,rt \"next start\" \"tsx server/collab.ts\" \"tsx server/realtime.ts\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:im": "tsx prisma/seed/im.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed/index.ts",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:build": "pnpm --dir desktop build",
    "desktop:bundle-server": "node scripts/desktop/bundle-server.mjs",
    "desktop:migration": "node scripts/desktop/migration.mjs",
    "desktop:check": "cargo check --manifest-path desktop/src-tauri/Cargo.toml",
    "mobile:sync": "pnpm --dir mobile sync",
    "mobile:build:debug": "pnpm --dir mobile build:debug",
    "mobile:build": "pnpm --dir mobile build",
    "mobile:publish": "node scripts/mobile/publish-apk.mjs",
    "docker:bundle-server": "node scripts/docker/bundle-server.mjs",
    "orca:icons": "node scripts/orca/extract-agent-icons.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@hocuspocus/extension-redis": "^4.9.0",
    "@hocuspocus/provider": "^4.9.0",
    "@hocuspocus/server": "^4.9.0",
    "@hocuspocus/transformer": "^4.9.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-collaboration-caret": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx-preview": "0.4.1",
    "dotenv": "^18.0.10",
    "fflate": "0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "jszip": "3.10.2",
    "lucide-react": "^1.75.0",
    "marked": "17.0.6",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "ws": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.21.0"
}

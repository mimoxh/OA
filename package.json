{
  "name": "oa-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,collab -c blue,magenta \"next dev\" \"tsx watch server/collab.ts\"",
    "dev:web": "next dev",
    "collab": "tsx server/collab.ts",
    "build": "next build",
    "start": "concurrently -k -n web,collab \"next start\" \"tsx server/collab.ts\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@hocuspocus/transformer": "^4.8.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-collaboration-caret": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "jose": "^6.2.17",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.21.0"
}
